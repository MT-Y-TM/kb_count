import { Button, LineEdit, ScrollView } from "std-widgets.slint";
component MetricCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> dark;
    width: 150px;
    height: 100px;
    background: dark ? #374151 : white;
    border-radius: 8px;
    VerticalLayout { padding: 12px; Text { text: label; color: dark ? #d1d5db : #566573; } Text { text: value; font-size: 24px; color: dark ? white : #17202a; } }
}
component HeatKey inherits Rectangle {
    in property <string> label;
    in property <int> count;
    width: 36px;
    height: 32px;
    border-radius: 4px;
    background: count == 0 ? #e5e7eb : count < 10 ? #bfdbfe : count < 50 ? #60a5fa : #1d4ed8;
    VerticalLayout { Text { text: label; color: count >= 50 ? white : #17202a; horizontal-alignment: center; } Text { text: count; color: count >= 50 ? white : #566573; horizontal-alignment: center; font-size: 10px; } }
}
export component MainWindow inherits Window {
    in property <string> status_text;
    in property <string> date_text;
    in property <string> keyboard_text;
    in property <string> mouse_text;
    in property <string> wheel_text;
    in property <string> app_text;
    in property <string> export_text;
    in property <string> ranking_text;
    in property <string> ranking_sort_text;
    in property <string> frequency_text;
    in property <string> heatmap_title;
    in property <string> detail_text;
    in property <string> settings_text;
    in property <string> startup_text;
    in property <string> clear_button_text;
    in property <string> theme_text;
    in-out property <string> export_from_date;
    in-out property <string> export_to_date;
    in property <int> heat_q;
    in property <int> heat_w;
    in property <int> heat_e;
    in property <int> heat_r;
    in property <int> heat_t;
    in property <int> heat_y;
    in property <int> heat_u;
    in property <int> heat_i;
    in property <int> heat_o;
    in property <int> heat_p;
    in property <int> heat_a;
    in property <int> heat_s;
    in property <int> heat_d;
    in property <int> heat_f;
    in property <int> heat_g;
    in property <int> heat_h;
    in property <int> heat_j;
    in property <int> heat_k;
    in property <int> heat_l;
    in property <int> heat_z;
    in property <int> heat_x;
    in property <int> heat_c;
    in property <int> heat_v;
    in property <int> heat_b;
    in property <int> heat_n;
    in property <int> heat_m;
    in property <int> heat_space;
    in-out property <string> query_date;
    in-out property <string> detail_path;
    in-out property <string> policy_path;
    in-out property <bool> dark_mode;
    callback pause_clicked();
    callback export_clicked();
    callback today_clicked();
    callback yesterday_clicked();
    callback query_clicked();
    callback sort_keyboard_clicked();
    callback sort_mouse_clicked();
    callback sort_total_clicked();
    callback query_app_clicked();
    callback policy_detailed_clicked();
    callback policy_totals_clicked();
    callback policy_excluded_clicked();
    callback startup_clicked();
    callback clear_data_clicked();
    callback theme_clicked();
    title: "kb_count";
    width: 720px;
    height: 760px;
    background: dark_mode ? #111827 : #f5f6f8;
    ScrollView {
        viewport-height: max(self.visible-height, content.preferred-height);
        content := VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text { text: "kb_count"; font-size: 28px; color: dark_mode ? white : #17202a; }
        HorizontalLayout { spacing: 8px; Text { text: date_text; color: #566573; } Button { text: "今日"; clicked => { root.today_clicked(); } } Button { text: "昨日"; clicked => { root.yesterday_clicked(); } } }
        Rectangle { height: 1px; background: #d5d8dc; }
        HorizontalLayout { spacing: 8px; LineEdit { text <=> root.query_date; placeholder-text: "YYYY-MM-DD"; } Button { text: "查询日期"; clicked => { root.query_clicked(); } } }
        HorizontalLayout { spacing: 8px; Text { text: "导出范围"; color: #566573; } LineEdit { text <=> root.export_from_date; placeholder-text: "开始 YYYY-MM-DD"; } LineEdit { text <=> root.export_to_date; placeholder-text: "结束 YYYY-MM-DD"; } }
        HorizontalLayout {
            spacing: 12px;
            MetricCard { label: "键盘敲击"; value: keyboard_text; dark: root.dark_mode; }
            MetricCard { label: "鼠标点击"; value: mouse_text; dark: root.dark_mode; }
            MetricCard { label: "滚轮单位"; value: wheel_text; dark: root.dark_mode; }
            MetricCard { label: "活跃应用"; value: app_text; dark: root.dark_mode; }
        }
        Rectangle { height: 1px; background: #d5d8dc; }
        Text { text: status_text; color: #2471a3; }
        HorizontalLayout {
            spacing: 12px;
            Button { text: "暂停 / 恢复统计"; clicked => { root.pause_clicked(); } }
            Button { text: "导出当前日期 CSV"; clicked => { root.export_clicked(); } }
        }
        Text { text: export_text; color: #566573; }
        HorizontalLayout { spacing: 8px; Text { text: "应用排行"; font-size: 18px; color: #17202a; } Text { text: ranking_sort_text; color: #566573; } Button { text: "键盘"; clicked => { root.sort_keyboard_clicked(); } } Button { text: "鼠标"; clicked => { root.sort_mouse_clicked(); } } Button { text: "总量"; clicked => { root.sort_total_clicked(); } } }
        Text { text: ranking_text; color: #566573; wrap: word-wrap; }
        Text { text: frequency_text; color: #566573; wrap: word-wrap; }
        Text { text: heatmap_title; font-size: 18px; color: #17202a; }
        HorizontalLayout { spacing: 3px; HeatKey { label: "Q"; count: heat_q; } HeatKey { label: "W"; count: heat_w; } HeatKey { label: "E"; count: heat_e; } HeatKey { label: "R"; count: heat_r; } HeatKey { label: "T"; count: heat_t; } HeatKey { label: "Y"; count: heat_y; } HeatKey { label: "U"; count: heat_u; } HeatKey { label: "I"; count: heat_i; } HeatKey { label: "O"; count: heat_o; } HeatKey { label: "P"; count: heat_p; } }
        HorizontalLayout { spacing: 3px; HeatKey { label: "A"; count: heat_a; } HeatKey { label: "S"; count: heat_s; } HeatKey { label: "D"; count: heat_d; } HeatKey { label: "F"; count: heat_f; } HeatKey { label: "G"; count: heat_g; } HeatKey { label: "H"; count: heat_h; } HeatKey { label: "J"; count: heat_j; } HeatKey { label: "K"; count: heat_k; } HeatKey { label: "L"; count: heat_l; } }
        HorizontalLayout { spacing: 3px; HeatKey { label: "Z"; count: heat_z; } HeatKey { label: "X"; count: heat_x; } HeatKey { label: "C"; count: heat_c; } HeatKey { label: "V"; count: heat_v; } HeatKey { label: "B"; count: heat_b; } HeatKey { label: "N"; count: heat_n; } HeatKey { label: "M"; count: heat_m; } HeatKey { label: "Space"; count: heat_space; width: 110px; } }
        Rectangle { height: 1px; background: #d5d8dc; }
        Text { text: "应用详情与采集策略"; font-size: 18px; color: #17202a; }
        HorizontalLayout { spacing: 8px; LineEdit { text <=> root.detail_path; placeholder-text: "输入应用完整路径"; } Button { text: "查询应用"; clicked => { root.query_app_clicked(); } } }
        Text { text: detail_text; color: #566573; wrap: word-wrap; }
        HorizontalLayout { spacing: 8px; LineEdit { text <=> root.policy_path; placeholder-text: "要设置策略的应用完整路径"; } Button { text: "详细"; clicked => { root.policy_detailed_clicked(); } } Button { text: "仅总量"; clicked => { root.policy_totals_clicked(); } } Button { text: "排除"; clicked => { root.policy_excluded_clicked(); } } }
        Text { text: settings_text; color: #566573; wrap: word-wrap; }
        HorizontalLayout { spacing: 8px; Button { text: startup_text; clicked => { root.startup_clicked(); } } Button { text: theme_text; clicked => { root.theme_clicked(); } } Button { text: clear_button_text; clicked => { root.clear_data_clicked(); } } }
            Text { text: "数据保存在可执行文件所在目录。"; color: #7b7d7d; }
        }
    }
}

