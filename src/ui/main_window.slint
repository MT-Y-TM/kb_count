import { LineEdit, ScrollView, ListView, Palette, CheckBox, ComboBox } from "std-widgets.slint";
import { AppRow, InputRow, HeatCell, ActionButton, NavItem, MetricCard, AppListRow, InputList, HeatKey, AppIcon } from "components.slint";
import { DatePicker, CalendarDay } from "date_picker.slint";
export { CalendarDay }
import { ActivityPage, AppPicker, ActivityCell, TrendSeries, TrendPoint, TrendTick, ChartApp, PieRow } from "activity.slint";
export { ActivityCell, TrendSeries, TrendPoint, TrendTick, ChartApp, PieRow }
import { CloseDialog } from "close_dialog.slint";

export component MainWindow inherits Window {
    in-out property <bool> close_open;
    in-out property <int> chart_view;
    in-out property <int> pie_mode;
    in property <[PieRow]> pie_rows;
    in property <image> pie_source;
    in property <bool> pie_has_data;
    in property <string> pie_total;
    in property <string> pie_range;
    in property <string> pie_scope;
    callback chart_view_selected(int);
    callback chart_pie_mode_selected(int);
    in-out property <bool> close_busy;
    in-out property <string> close_error;
    in-out property <bool> close_remember;
    in-out property <int> close_default_action;
    in-out property <bool> close_dialog_remember;
    in property <string> close_preferences_status;
    property <string> close_summary: !close_remember ? "每次询问" : close_default_action == 0 ? "仅关闭窗口，继续后台运行" : "退出应用";
    callback close_preferences_changed(bool, int);
    callback close_hide_clicked();
    callback close_exit_clicked();
    callback close_cancel_clicked();
    callback exit_requested();
    in property <[ActivityCell]> activity_cells;
    in property <[TrendSeries]> trend_series;
    in property <[TrendPoint]> trend_points;
    in property <[TrendTick]> trend_ticks;
    in property <[ChartApp]> chart_apps;
    in property <string> activity_year;
    in property <string> activity_summary;
    in property <int> activity_columns: 53;
    in property <string> trend_summary;
    in property <string> trend_range;
    in property <string> trend_note;
    in property <string> trend_maximum;
    in property <string> trend_middle;
    in-out property <int> trend_period;
    in-out property <string> trend_app_path;
    in-out property <string> trend_app_name: "全部应用";
    in-out property <bool> app_picker_open;
    in-out property <string> chart_app_search;
    callback charts_requested();
    callback chart_period_selected(int);
    callback chart_period_shift(int);
    callback chart_period_current();
    callback chart_year_shift(int);
    callback chart_day_selected(string);
    callback chart_series_toggled(int);
    callback chart_app_requested();
    callback chart_all_apps_selected();
    callback chart_app_chosen(string);
    callback chart_app_search_changed();
    in property <string> status_text;
    in property <bool> capture_limit_seen;
    in property <string> date_text;
    in property <string> keyboard_text;
    in property <string> mouse_text;
    in property <string> wheel_text;
    in property <string> app_text;
    in property <string> export_text;
    in property <string> detail_text;
    in property <string> settings_text;
    in property <string> startup_text;
    in property <string> clear_button_text;
    in property <string> clear_status;
    in property <string> theme_text;
    in-out property <string> export_from_date;
    in-out property <string> export_to_date;
    in property <int> heat_q;
    in property <int> heat_1;
    in property <int> heat_2;
    in property <int> heat_3;
    in property <int> heat_4;
    in property <int> heat_5;
    in property <int> heat_6;
    in property <int> heat_7;
    in property <int> heat_8;
    in property <int> heat_9;
    in property <int> heat_0;
    in property <int> heat_minus;
    in property <int> heat_equal;
    in property <int> heat_backspace;
    in property <int> heat_tab;
    in property <int> heat_w;
    in property <int> heat_e;
    in property <int> heat_r;
    in property <int> heat_t;
    in property <int> heat_y;
    in property <int> heat_u;
    in property <int> heat_i;
    in property <int> heat_o;
    in property <int> heat_p;
    in property <int> heat_left_bracket;
    in property <int> heat_right_bracket;
    in property <int> heat_enter;
    in property <int> heat_caps;
    in property <int> heat_a;
    in property <int> heat_s;
    in property <int> heat_d;
    in property <int> heat_f;
    in property <int> heat_g;
    in property <int> heat_h;
    in property <int> heat_j;
    in property <int> heat_k;
    in property <int> heat_l;
    in property <int> heat_semicolon;
    in property <int> heat_quote;
    in property <int> heat_backtick;
    in property <int> heat_left_shift;
    in property <int> heat_backslash;
    in property <int> heat_z;
    in property <int> heat_x;
    in property <int> heat_c;
    in property <int> heat_v;
    in property <int> heat_b;
    in property <int> heat_n;
    in property <int> heat_m;
    in property <int> heat_comma;
    in property <int> heat_period;
    in property <int> heat_slash;
    in property <int> heat_right_shift;
    in property <int> heat_ctrl;
    in property <int> heat_alt;
    in property <int> heat_right_ctrl;
    in property <int> heat_right_alt;
    in property <int> heat_space;
    in-out property <string> query_date;
    in-out property <bool> calendar_open;
    in property <string> calendar_month;
    in property <string> calendar_caption;
    in property <string> calendar_selection;
    in property <[CalendarDay]> calendar_days;
    callback calendar_requested(int);
    callback calendar_month_shift(int);
    callback calendar_day_shift(int);
    callback calendar_chosen(string);
    callback calendar_quick_chosen(int);
    in-out property <string> detail_path;
    in-out property <string> app_query_path;
    in-out property <string> policy_path;
    in-out property <bool> dark_mode;
    callback pause_clicked();
    callback export_clicked();
    callback today_clicked();
    callback yesterday_clicked();
    callback query_clicked();
    callback sort_keyboard_clicked();
    callback sort_mouse_clicked();
    callback sort_total_clicked();
    callback ranking_app_clicked(string);
    callback query_app_clicked();
    callback policy_detailed_clicked();
    callback policy_totals_clicked();
    callback policy_excluded_clicked();
    callback startup_clicked();
    callback clear_data_clicked();
    callback theme_clicked();

    in property <bool> capture_active: true;
    in property <bool> clear_confirmation;
    in property <[AppRow]> app_rows;
    in property <[AppRow]> all_app_rows;
    in-out property <string> app_search;
    in property <string> ranking_result;
    in property <string> ranking_share_label;
    callback app_search_changed();
    in property <[InputRow]> key_rows;
    in property <[InputRow]> mouse_rows;
    in property <[InputRow]> detail_key_rows;
    in property <[InputRow]> detail_mouse_rows;
    in property <bool> detail_loaded;
    in property <string> detail_name;
    in property <image> detail_icon;
    in property <bool> detail_has_icon;
    in property <string> detail_initial;
    in property <string> detail_mode_label;
    in property <string> detail_note;
    in property <string> detail_keyboard;
    in property <string> detail_mouse;
    in property <string> detail_wheel;
    in property <string> data_directory;
    in property <string> version_text;
    in property <string> policies_text;
    in property <string> heatmap_note;
    in property <[HeatCell]> heat_function_keys;
    in property <int> heatmap_max: 1;
    in property <int> ranking_sort;
    in-out property <int> selected_page;
    in-out property <length> page_scroll_y;
    in-out property <int> heatmap_scope;
    callback heatmap_all_clicked();
    callback heatmap_app_clicked();
    callback clear_cancel_clicked();
    in-out property <bool> compact_layout;
    in-out property <bool> short_charts;
    property <bool> narrow;
    function adapt-layout() {
        root.compact_layout = root.width < 1000px || root.height < 650px;
        root.short_charts = root.height < 500px;
        root.narrow = root.width < 960px;
    }
    changed width => { root.adapt-layout(); }
    changed height => { root.adapt-layout(); }
    property <color> surface: dark_mode ? #1c2636 : white;
    property <color> line: dark_mode ? #303c50 : #e5eaf2;
    property <color> ink: dark_mode ? #e8effb : #27364f;
    property <color> muted: dark_mode ? #aab9d0 : #5f708a;
    changed dark_mode => { Palette.color-scheme = root.dark_mode ? ColorScheme.dark : ColorScheme.light; }
    changed app_search => { root.app_search_changed(); }
    changed selected_page => {
        root.page_scroll_y = 0px;
        root.calendar_open = false;
        root.app_picker_open = false;
        if root.selected_page == 4 { root.charts_requested(); }
        if root.selected_page != 3 { root.clear_cancel_clicked(); }
    }
    changed chart_app_search => { root.chart_app_search_changed(); }
    init => { Palette.color-scheme = root.dark_mode ? ColorScheme.dark : ColorScheme.light; }

    title: "kb_count";
    icon: @image-url("../../assets/kb_count.svg");
    preferred-width: 1060px; preferred-height: 780px;
    min-width: 820px; min-height: 440px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    background: dark_mode ? #131c2b : #f5f7fb;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.narrow ? 128px : 168px; background: root.dark_mode ? #182233 : #ffffff;
            VerticalLayout {
                padding: root.narrow ? 10px : 16px; spacing: 9px;
                Rectangle {
                    height: 62px;
                    Image { x: 0px; y: 16px; width: 30px; height: 30px; source: @image-url("../../assets/kb_count.svg"); image-fit: contain; }
                    Text { x: root.narrow ? 35px : 40px; width: parent.width - (root.narrow ? 35px : 40px); height: parent.height; text: "kb_count"; font-size: root.narrow ? 14px : 17px; font-weight: 600; color: root.ink; vertical-alignment: center; }
                }
                if !root.narrow: Text { text: "你的输入，清晰可见"; font-size: 11px; color: root.muted; }
                Rectangle { height: 19px; }
                NavItem { compact: root.narrow; index: "01"; label: "输入总览"; dark: root.dark_mode; selected: root.selected_page == 0; activated => { root.selected_page = 0; } }
                NavItem { compact: root.narrow; index: "02"; label: "键位分布"; dark: root.dark_mode; selected: root.selected_page == 1; activated => { root.selected_page = 1; } }
                NavItem { compact: root.narrow; index: "03"; label: "应用详情"; dark: root.dark_mode; selected: root.selected_page == 2; activated => { root.selected_page = 2; } }
                NavItem { compact: root.narrow; index: "04"; label: "设置与数据"; dark: root.dark_mode; selected: root.selected_page == 3; activated => { root.selected_page = 3; } }
                NavItem { height: root.compact_layout ? 32px : 46px; compact: root.narrow; index: "05"; label: "活动趋势"; dark: root.dark_mode; selected: root.selected_page == 4; activated => { root.selected_page = 4; } }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: root.line; }
                Text { text: "仅在本地保存"; color: root.muted; font-size: 12px; }
                Text { text: "v" + root.version_text; color: root.muted; font-size: 11px; }
            }
        }
        Rectangle { width: 1px; background: root.line; }
        VerticalLayout {
            padding: root.compact_layout ? 12px : 26px; spacing: root.compact_layout ? 10px : 18px;
            HorizontalLayout {
                height: root.compact_layout ? 38px : 50px; spacing: 12px;
                VerticalLayout {
                    spacing: 5px;
                    Text { text: root.selected_page == 0 ? "输入总览" : root.selected_page == 1 ? "键位分布" : root.selected_page == 2 ? "应用详情" : root.selected_page == 4 ? "活动趋势" : "设置与数据"; font-size: root.compact_layout ? 22px : 25px; font-weight: 600; color: root.ink; }
                    if !root.compact_layout: Text { text: root.selected_page == 0 ? "查看每天的输入量与应用使用分布" : root.selected_page == 1 ? "按物理键位查看使用频率" : root.selected_page == 2 ? "深入了解单个应用的输入统计" : root.selected_page == 4 ? "年度活动与日、周、月、年输入趋势" : "管理采集方式、外观与本地数据"; font-size: 12px; color: root.muted; }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 88px; height: root.compact_layout ? 38px : 50px;
                    Rectangle {
                        y: root.compact_layout ? 5px : 11px; width: 88px; height: 28px; border-radius: 14px;
                        background: root.capture_active && !root.capture_limit_seen ? (root.dark_mode ? #1c3c36 : #eaf6f0) : (root.dark_mode ? #443b26 : #fff4df);
                        Rectangle { x: 11px; y: 12px; width: 5px; height: 5px; border-radius: 3px; background: root.capture_active && !root.capture_limit_seen ? #46a785 : #cf9a3e; }
                        Text { x: 22px; width: 60px; height: 28px; text: !root.capture_active ? "已暂停" : root.capture_limit_seen ? "可能受限" : "正在统计"; color: root.capture_active && !root.capture_limit_seen ? (root.dark_mode ? #9ad8c0 : #267253) : (root.dark_mode ? #efc77e : #805b18); font-size: 12px; vertical-alignment: center; }
                    }
                }
                VerticalLayout { horizontal-stretch: 0; padding-top: root.compact_layout ? 3px : 9px; padding-bottom: root.compact_layout ? 3px : 9px; ActionButton { text: root.capture_active ? "暂停统计" : "恢复统计"; clicked => { root.pause_clicked(); } } }
            }
            if root.capture_limit_seen: Rectangle {
                height: root.compact_layout ? 36px : 44px; border-radius: 8px;
                background: root.dark_mode ? #443b26 : #fff4df;
                Text { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                    text: "采集受限：本次运行曾检测到管理员应用，相关输入可能未计入。kb_count 保持普通权限。";
                    font-size: 12px; wrap: word-wrap; vertical-alignment: center;
                    color: root.dark_mode ? #efc77e : #805b18;
                }
            }
            if root.selected_page != 3: Rectangle {
                height: 44px; border-radius: 8px; background: root.surface; border-width: 1px; border-color: root.line;
                HorizontalLayout { padding: 6px; spacing: 8px;
                    ActionButton { text: "今日"; clicked => { root.today_clicked(); } }
                    ActionButton { text: "昨日"; clicked => { root.yesterday_clicked(); } }
                    Rectangle { width: 1px; background: root.line; }
                    LineEdit { width: 124px; text <=> root.query_date; accessible-label: "统计日期，YYYY-MM-DD"; placeholder-text: "YYYY-MM-DD"; accepted => { root.query_clicked(); } }
                    ActionButton { text: "查询"; clicked => { root.query_clicked(); } }
                    ActionButton { text: "选日期"; clicked => { root.calendar_requested(0); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.date_text; color: root.muted; font-size: 12px; vertical-alignment: center; }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if root.selected_page == 4: ActivityPage {
                    width: 100%; height: 100%; dark: root.dark_mode;
                    short_plot: root.short_charts;
                    view: root.chart_view; pie_mode: root.pie_mode;
                    pie_rows: root.pie_rows; pie_source: root.pie_source; pie_has_data: root.pie_has_data;
                    pie_total: root.pie_total; pie_range: root.pie_range; pie_scope: root.pie_scope;
                    view-selected(index) => { root.chart_view_selected(index); }
                    pie-mode-selected(index) => { root.chart_pie_mode_selected(index); }
                    year: root.activity_year; annual_summary: root.activity_summary;
                    summary: root.trend_summary; range: root.trend_range; note: root.trend_note;
                    app_name: root.trend_app_name; app_selected: root.trend_app_path != "";
                    period: root.trend_period; cells: root.activity_cells; columns: root.activity_columns;
                    series: root.trend_series; points: root.trend_points; ticks: root.trend_ticks;
                    maximum: root.trend_maximum; middle: root.trend_middle; scroll_y <=> root.page_scroll_y;
                    period-selected(index) => { root.chart_period_selected(index); }
                    period-shift(delta) => { root.chart_period_shift(delta); }
                    period-current => { root.chart_period_current(); }
                    app-requested => { root.chart_app_requested(); }
                    all-apps-selected => { root.chart_all_apps_selected(); }
                    year-shift(delta) => { root.chart_year_shift(delta); }
                    day-selected(date) => { root.chart_day_selected(date); }
                    series-toggled(index) => { root.chart_series_toggled(index); }
                }
                if root.selected_page == 0: ScrollView {
                    viewport-y <=> root.page_scroll_y;
                    viewport-height: max(self.visible-height, max(overview-content.preferred-height, overview-content.min-height));
                    overview-content := VerticalLayout {
                        spacing: root.compact_layout ? 10px : 18px;
                        HorizontalLayout { spacing: 12px;
                            MetricCard { compact: root.compact_layout; label: "键盘敲击"; value: root.keyboard_text; caption: "KEYSTROKES"; dark: root.dark_mode; accent: #5d87e5; }
                            MetricCard { compact: root.compact_layout; label: "鼠标点击"; value: root.mouse_text; caption: "MOUSE CLICKS"; dark: root.dark_mode; accent: #4eaa99; }
                            MetricCard { compact: root.compact_layout; label: "滚轮单位"; value: root.wheel_text; caption: "SCROLL UNITS"; dark: root.dark_mode; accent: #9a82cf; }
                            MetricCard { compact: root.compact_layout; label: "活跃应用"; value: root.app_text; caption: "APPLICATIONS"; dark: root.dark_mode; accent: #d8a667; }
                        }
                        Rectangle {
                            min-height: root.compact_layout ? 270px : 360px;
                            vertical-stretch: 1; border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { spacing: 0px;
                                HorizontalLayout { height: root.compact_layout ? 40px : 50px; padding-top: root.compact_layout ? 4px : 9px; padding-bottom: root.compact_layout ? 4px : 9px; padding-left: 18px; padding-right: 18px; spacing: 6px;
                                    Text { text: "应用输入排行"; color: root.ink; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { text: "总量"; primary: root.ranking_sort == 0; clicked => { root.sort_total_clicked(); } }
                                    ActionButton { text: "键盘"; primary: root.ranking_sort == 1; clicked => { root.sort_keyboard_clicked(); } }
                                    ActionButton { text: "鼠标"; primary: root.ranking_sort == 2; clicked => { root.sort_mouse_clicked(); } }
                                }
                                HorizontalLayout { height: 40px; padding-top: 0px; padding-bottom: 8px; padding-left: 18px; padding-right: 18px; spacing: 8px;
                                    LineEdit { text <=> root.app_search; placeholder-text: "搜索应用名称或路径"; }
                                    if root.app_search != "": ActionButton { text: "清除"; clicked => { root.app_search = ""; } }
                                    Text { text: root.ranking_result; color: root.muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; horizontal-stretch: 0; }
                                }
                                Rectangle { height: 31px; background: root.dark_mode ? #202c3e : #f8fafd;
                                    HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: root.narrow ? 8px : 12px;
                                        Text { text: "应用 / " + root.ranking_share_label; color: root.muted; font-size: 12px; vertical-alignment: center; }
                                        Text { width: root.narrow ? 62px : 72px; text: "键盘"; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; color: root.muted; }
                                        Text { width: root.narrow ? 54px : 64px; text: "鼠标"; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; color: root.muted; }
                                        Text { width: root.narrow ? 54px : 64px; text: "滚轮"; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; color: root.muted; }
                                        Text { width: root.narrow ? 70px : 82px; text: "总输入"; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; color: root.muted; }
                                    }
                                }
                                if root.app_rows.length > 0: ListView {
                                    for app in root.app_rows: AppListRow { compact: root.narrow; item: app; dark: root.dark_mode; sort-mode: root.ranking_sort; selected(path) => { root.ranking_app_clicked(path); root.selected_page = 2; } }
                                }
                                if root.app_rows.length == 0: VerticalLayout {
                                    padding: root.compact_layout ? 12px : 40px; spacing: 10px;
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: root.all_app_rows.length > 0 ? "没有匹配的应用" : "这一天还没有输入记录"; color: root.ink; font-size: root.compact_layout ? 14px : 17px; horizontal-alignment: center; }
                                    if !root.compact_layout: Text { text: root.all_app_rows.length > 0 ? "试试应用名称、部分路径，或清除搜索。" : "统计会自动保存在本地，稍后再来看看。"; color: root.muted; font-size: 12px; horizontal-alignment: center; }
                                    Rectangle { vertical-stretch: 1; }
                                }
                                Text { height: root.compact_layout ? 22px : 24px; text: root.narrow ? "总量 = 键盘 + 点击 + 滚轮；占比基于当天全部应用" : "总输入 = 键盘敲击 + 鼠标点击 + 滚轮单位；占比按当前排序，基于当天全部应用。"; color: root.muted; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
                            }
                        }
                    }
                }
                if root.selected_page == 1: ScrollView {
                    viewport-y <=> root.page_scroll_y;
                    viewport-height: max(self.visible-height, keys-content.preferred-height);
                    keys-content := VerticalLayout { spacing: 16px; padding-right: 6px;
                        Rectangle { border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { padding: 18px; spacing: 12px;
                                HorizontalLayout { spacing: 8px;
                                    Text { text: "键盘热力图"; color: root.ink; font-size: 16px; font-weight: 600; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { text: "全部应用"; primary: root.heatmap_scope == 0; clicked => { root.heatmap_scope = 0; root.heatmap_all_clicked(); } }
                                    ActionButton { text: "当前应用"; enabled: root.detail_loaded; primary: root.heatmap_scope == 1; clicked => { root.heatmap_scope = 1; root.heatmap_app_clicked(); } }
                                }
                                Text { text: root.heatmap_scope == 0 ? "全应用 · " + root.date_text : root.detail_name + " · " + root.date_text; color: root.muted; font-size: 12px; overflow: elide; }
                                ScrollView {
                                    height: 368px;
                                    viewport-width: max(self.visible-width, 630px);
                                    viewport-height: self.visible-height;
                                    vertical-scrollbar-policy: always-off;
                                    VerticalLayout { padding-top: 28px; padding-bottom: 4px; padding-right: 2px; spacing: 8px;
                                        HorizontalLayout { spacing: 4px; for key in root.heat_function_keys: HeatKey { label: key.label; count: key.count; dark: root.dark_mode; max-count: root.heatmap_max; } }
                                        HorizontalLayout { spacing: 4px; HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "`"; count: heat_backtick; width: 48px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "1"; count: heat_1; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "2"; count: heat_2; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "3"; count: heat_3; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "4"; count: heat_4; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "5"; count: heat_5; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "6"; count: heat_6; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "7"; count: heat_7; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "8"; count: heat_8; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "9"; count: heat_9; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "0"; count: heat_0; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "-"; count: heat_minus; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "="; count: heat_equal; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Bksp"; tooltip-right: true; count: heat_backspace; width: 58px; } }
                                        HorizontalLayout { spacing: 4px; HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Tab"; count: heat_tab; width: 48px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Q"; count: heat_q; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "W"; count: heat_w; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "E"; count: heat_e; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "R"; count: heat_r; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "T"; count: heat_t; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Y"; count: heat_y; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "U"; count: heat_u; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "I"; count: heat_i; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "O"; count: heat_o; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "P"; count: heat_p; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "["; count: heat_left_bracket; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "]"; count: heat_right_bracket; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "\\"; tooltip-right: true; count: heat_backslash; width: 58px; } }
                                        HorizontalLayout { spacing: 4px; HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Caps"; count: heat_caps; width: 58px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "A"; count: heat_a; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "S"; count: heat_s; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "D"; count: heat_d; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "F"; count: heat_f; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "G"; count: heat_g; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "H"; count: heat_h; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "J"; count: heat_j; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "K"; count: heat_k; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "L"; count: heat_l; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: ";"; count: heat_semicolon; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "'"; count: heat_quote; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Enter"; tooltip-right: true; count: heat_enter; width: 58px; } }
                                        HorizontalLayout { spacing: 4px; HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "LShift"; count: heat_left_shift; width: 64px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Z"; count: heat_z; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "X"; count: heat_x; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "C"; count: heat_c; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "V"; count: heat_v; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "B"; count: heat_b; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "N"; count: heat_n; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "M"; count: heat_m; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: ","; count: heat_comma; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "."; count: heat_period; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "/"; count: heat_slash; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "RShift"; tooltip-right: true; count: heat_right_shift; width: 64px; } }
                                        HorizontalLayout { spacing: 4px; HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "L Ctrl"; count: heat_ctrl; width: 58px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "L Alt"; count: heat_alt; width: 52px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "Space"; count: heat_space; width: 190px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "R Alt"; count: heat_right_alt; width: 52px; } HeatKey { dark: root.dark_mode; max-count: root.heatmap_max; label: "R Ctrl"; count: heat_right_ctrl; width: 58px; } }
                                    }
                                }
                                HorizontalLayout { spacing: 7px;
                                    Text { text: "低"; font-size: 11px; color: root.muted; }
                                    for tint in [#e5edfa, #b9d0f3, #91b4ee, #5d8ede, #3268c5]: Rectangle { width: 17px; height: 7px; border-radius: 2px; background: tint; }
                                    Text { text: "高"; font-size: 11px; color: root.muted; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "悬停查看次数"; font-size: 11px; color: root.muted; }
                                }
                                Text { text: root.heatmap_note; color: root.muted; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        HorizontalLayout { height: 280px; spacing: 16px;
                            InputList { title: "按键频率"; subtitle: "全部已记录物理键位"; rows: root.key_rows; dark: root.dark_mode; }
                            InputList { title: "鼠标与滚轮"; subtitle: "分类统计 · 不包含移动轨迹"; rows: root.mouse_rows; dark: root.dark_mode; }
                        }
                    }
                }
                if root.selected_page == 2: ScrollView {
                    viewport-y <=> root.page_scroll_y;
                    viewport-height: max(self.visible-height, detail-content.preferred-height);
                    detail-content := VerticalLayout { spacing: 16px; padding-right: 6px;
                        if !root.detail_loaded: Rectangle {
                            height: 220px; border-radius: 10px; background: root.surface; border-width: 1px; border-color: root.line;
                            VerticalLayout { padding: 40px; spacing: 12px;
                                Text { text: "选择一个应用"; color: root.ink; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "从输入总览点击应用，查看它的按键和鼠标统计。"; color: root.muted; horizontal-alignment: center; }
                                ActionButton { text: "返回应用排行"; clicked => { root.selected_page = 0; } }
                            }
                        }
                        if root.detail_loaded: Rectangle {
                            border-radius: 10px; background: root.surface; border-width: 1px; border-color: root.line;
                            VerticalLayout { padding: 20px; spacing: 10px;
                                HorizontalLayout { spacing: 12px;
                                    AppIcon { width: 40px; height: 40px; source: root.detail_icon; available: root.detail_has_icon; initial: root.detail_initial; dark: root.dark_mode; }
                                    Text { text: root.detail_name; color: root.ink; font-size: 22px; font-weight: 600; overflow: elide; }
                                    ActionButton { width: 132px; text: "查看键位分布"; clicked => { root.heatmap_scope = 1; root.heatmap_app_clicked(); root.selected_page = 1; } }
                                }
                                Text { text: root.detail_path; color: root.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: "采集方式：" + root.detail_mode_label; color: root.dark_mode ? #a9c4ed : #5b7cae; font-size: 12px; }
                            }
                        }
                        if root.detail_loaded: HorizontalLayout { spacing: 12px;
                            MetricCard { compact: root.compact_layout; label: "键盘敲击"; value: root.detail_keyboard; caption: "KEYSTROKES"; dark: root.dark_mode; }
                            MetricCard { compact: root.compact_layout; label: "鼠标点击"; value: root.detail_mouse; caption: "MOUSE CLICKS"; dark: root.dark_mode; accent: #4eaa99; }
                            MetricCard { compact: root.compact_layout; label: "滚轮单位"; value: root.detail_wheel; caption: "SCROLL UNITS"; dark: root.dark_mode; accent: #9a82cf; }
                        }
                        if root.detail_loaded: Text { text: root.detail_note; color: root.muted; font-size: 12px; wrap: word-wrap; }
                        if root.detail_loaded: HorizontalLayout { height: 280px; spacing: 16px;
                            InputList { title: "按键使用"; subtitle: "按频率排序"; rows: root.detail_key_rows; dark: root.dark_mode; empty-text: root.detail_note; }
                            InputList { title: "鼠标与滚轮"; subtitle: "按分类展示"; rows: root.detail_mouse_rows; dark: root.dark_mode; empty-text: root.detail_note; }
                        }
                        HorizontalLayout { spacing: 8px;
                            LineEdit { text <=> root.app_query_path; placeholder-text: "也可以输入应用完整路径"; accepted => { root.query_app_clicked(); } }
                            ActionButton { text: "查询应用"; clicked => { root.query_app_clicked(); } }
                            ActionButton { text: "管理采集策略"; enabled: root.detail_loaded; clicked => { root.policy_path = root.detail_path; root.selected_page = 3; } }
                        }
                        Text { text: root.detail_text; color: root.muted; font-size: 12px; wrap: word-wrap; }
                    }
                }
                if root.selected_page == 3: ScrollView {
                    viewport-y <=> root.page_scroll_y;
                    viewport-height: max(self.visible-height, settings-content.preferred-height);
                    settings-content := VerticalLayout { spacing: 16px; padding-right: 6px;
                        Rectangle { border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { padding: 20px; spacing: 14px;
                                Text { text: "偏好设置"; font-size: 16px; font-weight: 600; color: root.ink; }
                                HorizontalLayout { spacing: 12px;
                                    Text { text: "外观与启动"; color: root.muted; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton { text: root.theme_text; clicked => { root.theme_clicked(); } }
                                    ActionButton { text: root.startup_text; clicked => { root.startup_clicked(); } }
                                }
                                HorizontalLayout { spacing: 12px;
                                    Text { text: "关闭窗口时"; color: root.muted; vertical-alignment: center; }
                                    ComboBox { model: ["仅关闭窗口，继续后台运行", "退出应用，保存并停止统计"]; current-index <=> root.close_default_action;
                                        selected(value) => { root.close_preferences_changed(root.close_remember, self.current-index); }
                                    }
                                }
                                CheckBox { text: "关闭窗口时直接执行默认行为，不再询问"; checked <=> root.close_remember;
                                    toggled => { root.close_preferences_changed(self.checked, root.close_default_action); }
                                }
                                Text { min-height: 32px; text: root.close_preferences_status != "" ? root.close_preferences_status : "当前：" + root.close_summary + "。可取消记住，恢复每次询问。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                                Text { min-height: 32px; text: "采集范围：管理员或受保护应用中的输入可能无法统计。未采集到不代表没有操作。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        Rectangle { border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                Text { text: "应用采集策略"; font-size: 16px; font-weight: 600; color: root.ink; }
                                Text { text: "普通应用默认详细统计；浏览器仅统计总量；已知密码管理器默认排除。"; color: root.muted; font-size: 12px; wrap: word-wrap; }
                                LineEdit { text <=> root.policy_path; placeholder-text: "应用完整路径 · 可从应用详情自动带入"; }
                                HorizontalLayout { spacing: 8px;
                                    ActionButton { text: "详细统计"; clicked => { root.policy_detailed_clicked(); } }
                                    ActionButton { text: "仅统计总量"; clicked => { root.policy_totals_clicked(); } }
                                    ActionButton { text: "排除此应用"; clicked => { root.policy_excluded_clicked(); } }
                                }
                                Text { text: root.policies_text; color: root.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: root.settings_text; color: root.dark_mode ? #aec5ea : #5f7da8; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        Rectangle { border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                Text { text: "数据导出"; font-size: 16px; font-weight: 600; color: root.ink; }
                                Text { text: "导出选定日期范围的聚合统计，保存位置由你选择。"; color: root.muted; font-size: 12px; }
                                HorizontalLayout { spacing: 8px;
                                    LineEdit { text <=> root.export_from_date; accessible-label: "导出开始日期，YYYY-MM-DD"; placeholder-text: "开始 YYYY-MM-DD"; }
                                    ActionButton { text: "选择"; accessible-label: "选择导出开始日期"; clicked => { root.calendar_requested(1); } }
                                    Text { text: "至"; color: root.muted; vertical-alignment: center; }
                                    LineEdit { text <=> root.export_to_date; accessible-label: "导出结束日期，YYYY-MM-DD"; placeholder-text: "结束 YYYY-MM-DD"; }
                                    ActionButton { text: "选择"; accessible-label: "选择导出结束日期"; clicked => { root.calendar_requested(2); } }
                                    ActionButton { text: "导出 CSV"; clicked => { root.export_clicked(); } }
                                }
                                Text { text: root.export_text; color: root.muted; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        Rectangle { border-radius: 10px; border-width: 1px; border-color: root.line; background: root.surface;
                            VerticalLayout { padding: 20px; spacing: 12px;
                                Text { text: "本地存储"; font-size: 16px; font-weight: 600; color: root.ink; }
                                Text { text: root.data_directory; color: root.muted; font-size: 12px; wrap: word-wrap; }
                                Text { text: "SQLite · WAL 模式 · 随程序目录一起迁移"; color: root.muted; font-size: 12px; }
                                Text { min-height: 32px; text: root.clear_status == "" ? "清空统计会保留应用策略，操作不可撤销。" : root.clear_status;
                                    color: root.clear_confirmation || root.clear_status == "" ? (root.dark_mode ? #caa39e : #91584f) : root.muted;
                                    font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                                HorizontalLayout { spacing: 8px;
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.clear_confirmation: ActionButton { width: 72px; text: "取消"; clicked => { root.clear_cancel_clicked(); } }
                                    ActionButton { width: 148px; text: root.clear_button_text; clicked => { root.clear_data_clicked(); } }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout { height: 32px; spacing: 8px;
                Text { text: root.status_text; color: root.muted; font-size: 11px; overflow: elide; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "关闭：" + root.close_summary; color: root.muted; font-size: 11px; }
                if root.page_scroll_y < -64px: ActionButton { text: "回到顶部"; clicked => { root.page_scroll_y = 0px; } }
            }
        }
    }
    Rectangle {
        width: 100%; height: 100%;
        visible: root.calendar_open;
        background: #101b2c88;
        TouchArea { clicked => { root.calendar_open = false; } scroll-event => { return accept; } }
        DatePicker {
            active: root.calendar_open;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            dark: root.dark_mode; caption: root.calendar_caption; month: root.calendar_month;
            selection: root.calendar_selection; days: root.calendar_days;
            month-shift(delta) => { root.calendar_month_shift(delta); }
            day-shift(delta) => { root.calendar_day_shift(delta); }
            chosen(date) => { root.calendar_chosen(date); }
            quick-chosen(offset) => { root.calendar_quick_chosen(offset); }
            dismissed => { root.calendar_open = false; }
        }
    }
    Rectangle {
        width: 100%; height: 100%; visible: root.app_picker_open; background: #101b2c88;
        TouchArea { clicked => { root.app_picker_open = false; } scroll-event => { return accept; } }
        AppPicker {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            active: root.app_picker_open; dark: root.dark_mode; search <=> root.chart_app_search; apps: root.chart_apps;
            chosen(path) => { root.chart_app_chosen(path); }
            dismissed => { root.app_picker_open = false; }
        }
    }
    Rectangle {
        width: 100%; height: 100%; visible: root.close_open; background: #101b2c88;
        TouchArea { scroll-event => { return accept; } }
        CloseDialog {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            dark: root.dark_mode; active: root.close_open; busy: root.close_busy; error: root.close_error;
            remember <=> root.close_dialog_remember;
            hide-panel => { root.close_hide_clicked(); }
            canceled => { root.close_cancel_clicked(); }
            exit-app => { root.close_exit_clicked(); }
        }
    }
}

